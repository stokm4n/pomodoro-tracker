# PostgreSQL container settings
POSTGRES_DB=pomodoro
POSTGRES_USER=pomodoro
POSTGRES_PASSWORD=pomodoro_dev_password
POSTGRES_PORT=5432

# Backend settings
DATABASE_URL=postgres://pomodoro:pomodoro_dev_password@localhost:5432/pomodoro?sslmode=disable
SERVER_PORT=8080
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:5173

